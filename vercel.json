{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs?__vpath=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.cjs?__vpath=/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/|assets/|src/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
