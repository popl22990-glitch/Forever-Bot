{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/[...slug].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|assets/|src/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
