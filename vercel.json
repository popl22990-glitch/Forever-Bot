{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vpath=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__vpath=/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/|assets/|src/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
